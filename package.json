{
  "name": "united-delhi",
  "version": "1.0.7",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node web/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/lib/__tests__/*.test.ts\"",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-local-v1.ps1",
    "web:check": "node web/check.mjs",
    "build": "npm --prefix web install && npm --prefix web run build",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "build:android:local": "powershell -ExecutionPolicy Bypass -File scripts/build-local-v1.ps1"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.20",
    "@react-navigation/native-stack": "^7.3.29",
    "expo": "~57.0.26",
    "expo-location": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "react": "19.3.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "description": "Delhi DTC bus tracking app",
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
