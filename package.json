{
  "name": "united-delhi",
  "version": "1.0.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node web/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/lib/__tests__/*.test.ts\"",
    "build:apk": "eas build -p android --profile preview",
    "web:check": "node web/check.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.20",
    "@react-navigation/native-stack": "^7.3.29",
    "expo": "~57.0.25",
    "expo-location": "~58.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "description": "Delhi DTC bus tracking app",
  "overrides": {
    "uuid": "11.1.1"
  }
}
