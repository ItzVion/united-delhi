{
  "expo": {
    "name": "United Delhi",
    "slug": "united-delhi",
    "version": "1.0.8",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uniteddelhi.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "United Delhi uses your location to find nearby DTC bus stops."
      }
    },
    "android": {
      "package": "com.uniteddelhi.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "backgroundColor": "#F4F7F4",
      "icon": "./assets/icon.png",
      "predictiveBackGestureEnabled": true,
      "versionCode": 8
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/united-delhi-logo.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "United Delhi uses your location to find nearby DTC bus stops."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7F4",
          "image": "./assets/united-delhi-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "extra": {
      "eas": {
        "projectId": "a071b353-9f0b-4e78-8c1a-6e0fd36ced4e"
      }
    },
    "owner": "itzvion"
  }
}
