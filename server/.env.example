PORT=10000
DATABASE_URL=
# Required for live bus tracking. Keep the key only in backend secret storage.
TRANSPORT_STACK_API_KEY=
TRANSPORT_STACK_REALTIME_URL=https://dts-backend.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb
# Optional; keep unset unless the provider documents a per-vehicle physical-colour field.
TRANSPORT_STACK_COLOR_FIELD=
APP_ORIGINS=https://united-delhi.vercel.app
DTC_STATIC_FILE=
DTC_STATIC_URL=https://ethanc8.github.io/delhi-gtfs/bus.zip
DTC_STATIC_SOURCE_KEY=ethanc8-delhi-gtfs-bus
DTC_STATIC_AUTO_IMPORT=true
METRO_STATIC_FILE=
METRO_STATIC_URL=https://ethanc8.github.io/delhi-gtfs/metro.zip
METRO_STATIC_SOURCE_KEY=uploaded-dmrc-static-local-v1-20261013
METRO_AUTO_SYNC=true
# METRO_ALLOW_EXPIRED_CALENDAR=true permits reviewed topology-only planning from an expired timetable feed; times remain estimates.

# Static feed replacement is explicitly opt-in; keep false in unattended environments.
DTC_STATIC_ALLOW_REPLACEMENT=false
DTC_ALLOW_EXPIRED_CALENDAR=false
DTC_ALLOW_INVALID_CALENDAR=false
METRO_STATIC_ALLOW_REPLACEMENT=false
METRO_ALLOW_EXPIRED_CALENDAR=false
METRO_ALLOW_INVALID_CALENDAR=false
