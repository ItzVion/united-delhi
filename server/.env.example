PORT=10000
DATABASE_URL=
# Preferred realtime source: official Delhi Open Transit Data. Keep the private key on the backend only.
OTD_API_KEY=
OTD_REALTIME_URL=https://otd.delhi.gov.in/api/realtime/VehiclePositions.pb
# Leave OTD_COLOR_FIELD unset unless OTD confirms a private protobuf field means exact per-vehicle physical paint colour.
OTD_COLOR_FIELD=
# Optional legacy fallback. Used only when OTD_API_KEY is not configured.
# Leave TRANSPORT_STACK_COLOR_FIELD unset unless the provider confirms a per-vehicle physical-colour field.
TRANSPORT_STACK_COLOR_FIELD=
TRANSPORT_STACK_API_KEY=
TRANSPORT_STACK_REALTIME_URL=https://dts-backend.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb
APP_ORIGINS=https://united-delhi.vercel.app
DTC_STATIC_FILE=
DTC_STATIC_SOURCE_KEY=uploaded-dtc-static-local-v1-20261013
DTC_STATIC_AUTO_IMPORT=true
METRO_STATIC_FILE=
METRO_STATIC_SOURCE_KEY=uploaded-dmrc-static-local-v1-20261013
METRO_AUTO_SYNC=true

# These are explicit operator opt-ins; keep false for unattended startup.
DTC_STATIC_ALLOW_REPLACEMENT=false
DTC_ALLOW_EXPIRED_CALENDAR=false
DTC_ALLOW_INVALID_CALENDAR=false
METRO_STATIC_ALLOW_REPLACEMENT=false
METRO_ALLOW_EXPIRED_CALENDAR=false
METRO_ALLOW_INVALID_CALENDAR=false
