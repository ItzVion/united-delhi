PORT=10000
DATABASE_URL=
# Authorised Delhi Open Transit Data private key. Keep it only in backend secret storage.
OTD_API_KEY=
# Optional OTD-specific protobuf extension field; leave empty unless formally verified.
OTD_COLOR_FIELD=
# Temporary one-time GTFS upload token. Clear it after both imports succeed.
STATIC_IMPORT_TOKEN=
APP_ORIGINS=https://united-delhi.vercel.app
DTC_STATIC_FILE=
DTC_STATIC_URL=
DTC_STATIC_SOURCE_KEY=user-uploaded-dtc-static-v1-20261030
DTC_STATIC_AUTO_IMPORT=false
METRO_STATIC_FILE=
METRO_STATIC_URL=
METRO_STATIC_SOURCE_KEY=user-uploaded-dmrc-static-v1-20261030
METRO_AUTO_SYNC=false
# METRO_ALLOW_EXPIRED_CALENDAR=true permits reviewed topology-only planning from an expired timetable feed; times remain estimates.

# User-uploaded static feeds are imported once; keep unattended replacement disabled.
DTC_STATIC_ALLOW_REPLACEMENT=false
DTC_ALLOW_EXPIRED_CALENDAR=false
DTC_ALLOW_INVALID_CALENDAR=false
METRO_STATIC_ALLOW_REPLACEMENT=false
METRO_ALLOW_EXPIRED_CALENDAR=true
METRO_ALLOW_INVALID_CALENDAR=false
